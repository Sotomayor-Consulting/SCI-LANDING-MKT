---

<main id="inicio" class="overflow-hidden">
  <section class="bg-muted/50 relative py-14 sm:py-14">
    <div
      class="pointer-events-none absolute inset-0 [background-image:radial-gradient(#c9d3dc_1px,transparent_1px)] [background-size:28px_28px] opacity-60"
    >
    </div>
    <div
      class="pointer-events-none absolute top-4 -right-36 size-[32rem] rounded-full bg-[#e8c77c]/20 blur-3xl"
    >
    </div>
    <div
      class="relative mx-auto grid max-w-7xl items-start gap-12 px-5 lg:grid-cols-[1.08fr_.78fr] lg:px-8"
    >
      <Herolabels
        badge="Firma legal, fiscal y tecnológica"
        titleLine1="Tu LLC en Estados Unidos,"
        highlighted="bien hecha"
        description=" Una asesoría estratégica para definir si una LLC es lo que necesitas, en qué
    estado conviene abrirla y cómo evitar errores legales, fiscales y bancarios."
        note="30 min · por Zoom · sin compromiso"
        labelBtn="Agendar mi asesoría"
        infolabels="+5.000"
        infodescrition="empresas incorporadas"
        infoscore="4,8/5 clientes"
        benefits={benefits}
      />

      <Formulario adviceOptions={adviceOptions} activities={activities} />
    </div>
  </section>

  <section class="border-y border-slate-200 bg-white py-7">
    <Marquee logos={logos} />
  </section>

  <section class="py-20 sm:py-24">
    <Insights
      label="Para quién es"
      title="Una estructura internacional para negocios que ya piensan global."
      audiences={audiences}
    />
  </section>

  <section class="bg-foreground text-background relative py-20 sm:py-24">
    <Insight_1
      label="Primero, estrategia"
      title="Abrir es fácil. Abrir bien es otra historia."
      description="Una mala decisión puede sumar costos, obligaciones innecesarias o retrasos
      bancarios. Por eso no empezamos vendiéndote un paquete."
      labelBtn="Revisar mi caso gratis"
      href="#agendar"
      insights={insights}
    />
  </section>

  <section id="proceso" class="bg-muted scroll-mt-24 py-20 sm:py-24">
    <Insight_2
      label="Cómo funciona"
      title="De la duda a un plan concreto en tres pasos."
      steps={steps}
    />
  </section>

  <section id="planes" class="scroll-mt-24 py-20 sm:py-24">
    <Pricing
      heading="Valores anuales sin considerar pagos gubernamentales."
      description="El plan ideal según tu caso lo definimos en la primera asesoría."
      plans={planes}
    />
  </section>

  <section class="bg-muted py-20 sm:py-24">
    <Experience
      label="Experiencia comprobada"
      title="Confianza que se construye caso por caso."
      description="Un equipo multidisciplinario acompaña cada estructura desde la
      constitución hasta su mantenimiento."
      experience={experience}
    />
  </section>

  <section id="preguntas" class="scroll-mt-24 py-20 sm:py-24">
    <Faqs
      label="Preguntas frecuentes"
      title="Lo que debes saber antes de empezar."
      description="Si tu duda no aparece, la resolvemos durante la asesoría."
      faqs={faqs}
    />
  </section>

  <section class="px-5 pb-20 lg:px-8">
    <Cta
      label="Tu primer paso"
      title="Decide con claridad antes de invertir."
      description="Descubre qué estructura necesita realmente tu proyecto."
      href="#agendar"
      descriptionBtn="Agendar asesoría gratuita"
    />
  </section>
</main>

<FixedBtn />

<script>
  const form1 = document.querySelector<HTMLFormElement>("#lead-form-1");
  const form2 = document.querySelector<HTMLFormElement>("#lead-form-2");
  const formStep1 = document.querySelector<HTMLElement>("#form-step-1");
  const formStep2 = document.querySelector<HTMLElement>("#form-step-2");
  const calendarStep = document.querySelector<HTMLElement>("#calendar-step");
  const formCard = document.querySelector<HTMLElement>("#agendar");
  const contactTitle = document.querySelector<HTMLElement>("#contact-title");
  const backBtn = document.querySelector<HTMLButtonElement>("#back-btn");
  const frame = document.querySelector<HTMLIFrameElement>("#calendar-frame");
  const greeting = document.querySelector<HTMLElement>("#calendar-greeting");
  const calendarTitle = document.querySelector<HTMLElement>("#calendar-title");
  const error1 = document.querySelector<HTMLElement>("#form-error-1");
  const error2 = document.querySelector<HTMLElement>("#form-error-2");
  const error2Description = document.querySelector<HTMLElement>(
    "#form-error-2-description",
  );
  const phoneInput = document.querySelector<HTMLInputElement>("#phone");
  const submitButton =
    document.querySelector<HTMLButtonElement>("#lead-submit");

  const submissionId = crypto.randomUUID();
  let isSubmitting = false;

  function setForm2Error(message: string) {
    if (error2Description) error2Description.textContent = message;
    error2?.classList.remove("hidden");
  }

  function setSubmitting(submitting: boolean) {
    isSubmitting = submitting;
    if (!submitButton) return;
    submitButton.disabled = submitting;
    submitButton.textContent = submitting ? "Guardando..." : "Elegir horario";
    if (submitting) submitButton.setAttribute("aria-busy", "true");
    else submitButton.removeAttribute("aria-busy");
  }

  function showStep(
    step: HTMLElement | null | undefined,
    direction: "forward" | "backward" = "forward",
  ) {
    if (formCard) formCard.dataset.stepDirection = direction;
    [formStep1, formStep2, calendarStep].forEach((s) =>
      s?.classList.add("hidden"),
    );
    step?.classList.remove("hidden");
  }

  form1?.addEventListener("submit", (event) => {
    event.preventDefault();
    if (!form1.checkValidity()) {
      form1.reportValidity();
      error1?.classList.remove("hidden");
      return;
    }
    error1?.classList.add("hidden");
    showStep(formStep2);
    document
      .querySelector("#agendar")
      ?.scrollIntoView({ behavior: "smooth", block: "start" });
    contactTitle?.focus({ preventScroll: true });
  });

  backBtn?.addEventListener("click", () => {
    showStep(formStep1, "backward");
    document
      .querySelector("#agendar")
      ?.scrollIntoView({ behavior: "smooth", block: "start" });
  });

  phoneInput?.addEventListener("input", () => {
    phoneInput.setCustomValidity("");
  });

  form2?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (isSubmitting) return;
    phoneInput?.setCustomValidity("");
    const phoneDigits = String(phoneInput?.value || "").replace(/\D/g, "");
    if (phoneInput?.value && phoneDigits.length < 7) {
      phoneInput.setCustomValidity(
        "Escribe un número de teléfono válido (al menos 7 dígitos).",
      );
    }
    if (!form2.checkValidity()) {
      form2.reportValidity();
      setForm2Error("Revisa los campos indicados antes de continuar.");
      return;
    }
    error2?.classList.add("hidden");
    const data2 = new FormData(form2);
    const data1 = form1 ? new FormData(form1) : new FormData();
    const name = String(data2.get("name") || "");
    const phone = `${data2.get("country") || ""}${String(
      data2.get("phone") || "",
    )
      .replace(/\D/g, "")
      .replace(/^0+/, "")}`;

    setSubmitting(true);
    try {
      const response = await fetch("/api/leads", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          submissionId,
          name,
          email: String(data2.get("email") || ""),
          countryCode: String(data2.get("country") || ""),
          phone: String(data2.get("phone") || ""),
          activity: String(data1.get("activity") || ""),
          advice: String(data1.get("advice") || ""),
          question: String(data1.get("question") || ""),
          source: "landing",
          website: String(data2.get("website") || ""),
        }),
      });

      if (!response.ok) {
        setForm2Error("No pudimos guardar tus datos. Inténtalo nuevamente.");
        return;
      }

      const trackingWindow = window as Window & {
        dataLayer?: Array<Record<string, unknown>>;
      };
      trackingWindow.dataLayer = trackingWindow.dataLayer || [];
      trackingWindow.dataLayer.push({
        event: "lead_datos_completados",
      });
      try {
        localStorage.setItem("llcLeadSubmissionId", submissionId);
      } catch {
        // The lead flow must continue when browser storage is unavailable.
      }
    } catch {
      setForm2Error(
        "No pudimos conectar con el servidor. Revisa tu conexión e inténtalo nuevamente.",
      );
      return;
    } finally {
      setSubmitting(false);
    }

    const url = new URL("https://zcal.co/t/agendar-asesoria-llc/60-USA");
    url.searchParams.set("name", name);
    url.searchParams.set("email", String(data2.get("email") || ""));
    url.searchParams.set("smsPhone", phone);
    url.searchParams.set("a0", phone);
    url.searchParams.set("a1", String(data1.get("activity") || ""));
    url.searchParams.set("a2", String(data1.get("advice") || ""));
    url.searchParams.set("a3", String(data1.get("question") || ""));
    if (frame) frame.src = url.toString();
    if (greeting)
      greeting.textContent = `${name.split(" ")[0]}, tus datos están listos. Selecciona el día y la hora.`;
    showStep(calendarStep);
    document
      .querySelector("#agendar")
      ?.scrollIntoView({ behavior: "smooth", block: "start" });
    calendarTitle?.focus({ preventScroll: true });
  });
</script>
