---
import { Image } from "astro:assets";
import { Button } from "@/components/starwind/button";
import {
  Accordion,
  AccordionContent,
  AccordionItem,
  AccordionTrigger,
} from "@/components/starwind/accordion";
import { Alert, AlertDescription } from "@/components/starwind/alert";
import { Badge } from "@/components/starwind/badge";
import {
  Card,
  CardContent,
  CardDescription,
  CardFooter,
  CardHeader,
  CardTitle,
} from "@/components/starwind/card";
import {
  Field,
  FieldControl,
  FieldError,
  FieldLabel,
} from "@/components/starwind/field";
import { Form } from "@/components/starwind/form";
import {
  NativeSelect,
  NativeSelectOption,
} from "@/components/starwind/native-select";
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from "@/components/starwind/select";
import { Separator } from "@/components/starwind/separator";
import { Textarea } from "@/components/starwind/textarea";

const benefits = [
  "Sin visa ni residencia",
  "Sin SSN ni ITIN",
  "100% remoto y en español",
];
const audiences = [
  ["E-commerce", "Cobra con Stripe, Amazon o pasarelas internacionales."],
  ["Agencias", "Factura a clientes globales y recibe pagos en dólares."],
  ["SaaS y creadores", "Opera productos digitales con una estructura clara."],
  ["Inversionistas", "Ordena inversiones y activos en Estados Unidos."],
];
const activities = [
  "Exportación de servicios profesionales",
  "E-commerce",
  "Trader / compra-venta de productos",
  "Invertir en Bolsa de Valores",
  "Trader de Stocks",
  "Proteger mi patrimonio",
  "Negocios en bienes raíces",
  "Fintech",
];
const adviceOptions = [
  "Sí, quiero revisar mi caso con un experto",
  "Primero quiero más información",
  "Me interesa, pero aún no estoy listo",
];
const steps = [
  [
    "01",
    "Cuéntanos tu caso",
    "Comparte tus datos y el objetivo principal de tu proyecto.",
  ],
  [
    "02",
    "Habla con un asesor",
    "Revisamos actividad, socios, residencia y planes de crecimiento.",
  ],
  [
    "03",
    "Recibe una ruta clara",
    "Sales con estado recomendado, costos y próximos pasos.",
  ],
];
const plans = [
  ["Básico", "350", "Constitución, EIN y agente registrado."],
  ["Estándar", "600", "Documentos internos y acompañamiento continuo."],
  ["Business", "950", "Planificación legal, fiscal y apoyo bancario."],
];
const faqs = [
  [
    "¿La asesoría realmente es gratuita?",
    "Sí. La reunión inicial no tiene costo ni compromiso. Primero evaluamos si una LLC encaja con tu situación.",
  ],
  [
    "¿Puedo abrir una LLC sin vivir en Estados Unidos?",
    "Sí. Una persona no residente puede constituir una LLC. La estructura y obligaciones adecuadas dependen de su actividad y país de residencia.",
  ],
  [
    "¿Cuánto tarda el proceso?",
    "El registro estatal suele tomar entre 5 y 10 días hábiles. El EIN puede tardar varias semanas, según el IRS.",
  ],
  [
    "¿Qué documentos necesito?",
    "Normalmente necesitarás pasaporte vigente y comprobante de domicilio reciente de cada socio.",
  ],
  [
    "¿Qué incluye el costo?",
    "Cada plan incluye servicios distintos. La tasa estatal se paga por separado y varía según la jurisdicción.",
  ],
];
---

<header
  class="sticky top-0 z-50 border-b border-slate-200/80 bg-white/90 backdrop-blur-xl"
>
  <div
    class="mx-auto flex min-h-18 max-w-7xl items-center justify-between px-5 lg:px-8"
  >
    <a
      href="#inicio"
      class="flex items-center gap-3"
      aria-label="Nexo International, inicio"
    >
      <Image
        src="https://www.sotomayorconsulting.com/wp-content/uploads/2026/06/Recurso-4.png"
        alt="Nexo International"
        class="w-35 h-auto"
        width={62}
        height={32}
      />
    </a>
    <nav
      class="hidden items-center gap-7 text-sm font-semibold text-slate-600 md:flex"
      aria-label="Navegación principal"
    >
      <a href="#proceso" class="hover:text-primary-accent">Proceso</a><a
        href="#planes"
        class="hover:text-primary-accent">Planes</a
      ><a href="#preguntas" class="hover:text-primary-accent">Preguntas</a>
    </nav>
    <Button
      href="#agendar"
      variant="primary"
      size="sm"
      class="rounded-full px-5 font-bold">Agendar gratis</Button
    >
  </div>
</header>

<main id="inicio" class="overflow-hidden">
  <section class="relative bg-muted/50 py-14 sm:py-14">
    <div
      class="pointer-events-none absolute inset-0 opacity-60 [background-image:radial-gradient(#c9d3dc_1px,transparent_1px)] [background-size:28px_28px]"
    >
    </div>
    <div
      class="pointer-events-none absolute -right-36 top-4 size-[32rem] rounded-full bg-[#e8c77c]/20 blur-3xl"
    >
    </div>
    <div
      class="relative mx-auto grid max-w-7xl items-start gap-12 px-5 lg:grid-cols-[1.08fr_.78fr] lg:px-8"
    >
      <div class="pt-2 lg:pt-8">
        <Badge
          tone="primary-accent"
          appearance="frosted"
          eyebrow
          size="sm"
          class="mb-6"
        >
          <span class="size-1.5 rounded-full bg-primary-accent"></span>
          Firma legal, fiscal y tecnológica
        </Badge>
        <h1
          class="max-w-3xl font-display text-4xl font-bold leading-[1.08] tracking-[-.04em] text-foreground sm:text-5xl lg:text-[4rem]"
        >
          Tu LLC en Estados Unidos, <span
            class="relative whitespace-nowrap text-primary-accent after:absolute after:inset-x-0 after:bottom-1 after:-z-10 after:h-3 after:bg-primary/30"
            >bien hecha</span
          > desde el inicio.
        </h1>
        <p class="mt-7 max-w-2xl text-lg leading-8 text-slate-600">
          Una asesoría estratégica para definir si una LLC es lo que necesitas,
          en qué estado conviene abrirla y cómo evitar errores legales, fiscales
          y bancarios.
        </p>
        <div class="mt-7 grid gap-3 sm:grid-cols-3">
          {
            benefits.map((benefit) => (
              <Badge
                tone="success"
                appearance="soft"
                size="sm"
                class="justify-start whitespace-normal"
              >
                <svg
                  viewBox="0 0 20 20"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                >
                  <path d="m4 10 4 4 8-8" />
                </svg>
                {benefit}
              </Badge>
            ))
          }
        </div>
        <div class="mt-9 flex flex-wrap items-center gap-4">
          <Button
            href="#agendar"
            variant="primary"
            size="lg"
            class="rounded-xl px-7 font-bold shadow-lg shadow-amber-900/10 hover:-translate-y-0.5"
            >Agendar mi asesoría <svg
              viewBox="0 0 24 24"
              class="size-4"
              fill="none"
              stroke="currentColor"
              stroke-width="2"><path d="m9 18 6-6-6-6"></path></svg
            ></Button
          >
          <span class="text-sm text-slate-500"
            >30 min · por Zoom · sin compromiso</span
          >
        </div>
        <Separator class="mt-10" />
        <div
          class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-muted-foreground"
        >
          <strong class="font-display text-xl text-foreground">+5.000</strong
          ><span>empresas incorporadas</span>
          <Separator orientation="vertical" class="hidden h-5 sm:block" />
          <strong class="text-primary-accent">★★★★★</strong><span
            >4,8/5 clientes</span
          >
        </div>
      </div>

      <Card
        id="agendar"
        class="scroll-mt-24 rounded-[1.75rem] border-primary-accent/40 bg-foreground text-background shadow-2xl shadow-slate-900/20 px-5"
      >
        <div id="form-step-1" class="flex flex-col gap-3">
          <CardHeader>
            <div class="flex items-center justify-between">
              <Badge
                tone="primary-accent"
                appearance="outline"
                eyebrow
                size="sm">Asesoría gratuita</Badge
              >
              <Badge
                tone="neutral"
                appearance="text"
                size="sm"
                class="text-white/50">Paso 1 de 3</Badge
              >
            </div>
            <CardTitle
              ><h2 class="font-display text-2xl font-semibold text-white">
                Cuéntanos tu caso
              </h2></CardTitle
            >
            <CardDescription class="text-white/65"
              >Responde unas preguntas y después completaremos tus datos.</CardDescription
            >
          </CardHeader>
          <Form id="lead-form-1" novalidate class="flex flex-col gap-5">
            <CardContent class="flex flex-col gap-6">
              <div class="flex flex-col gap-2">
                <p class="text-sm font-medium text-white/75">
                  ¿Para qué actividad quieres crear tu LLC?
                </p>
                <p class="text-xs text-white/50">Selecciona tu actividad principal.</p>
                <Select
                  name="activity"
                  required
                >
                  <SelectTrigger
                    size="sm"
                    class="border-white/15 bg-white/7 text-white data-placeholder:text-white/40 w-full"
                    placeholder="Selecciona una actividad"
                  >
                    <SelectValue placeholder="Selecciona una actividad" />
                  </SelectTrigger>
                  <SelectContent>
                    {activities.map((activity) => (
                      <SelectItem value={activity} class="max-w-full">{activity}</SelectItem>
                    ))}
                  </SelectContent>
                </Select>
              </div>

              <div class="flex flex-col gap-2">
                <p class="text-sm font-medium text-white/75">
                  ¿Quieres una asesoría gratuita por Zoom?
                </p>
                <Select name="advice" required >
                  <SelectTrigger
                    size="sm"
                    class="border-white/15 bg-white/7 text-white data-placeholder:text-white/40 w-full"
                    placeholder="Selecciona una opción"
                  >
                    <SelectValue placeholder="Selecciona una opción" />
                  </SelectTrigger>
                  <SelectContent>
                    {adviceOptions.map((option) => (
                      <SelectItem value={option}>{option}</SelectItem>
                    ))}
                  </SelectContent>
                </Select>
              </div>

              <div class="flex flex-col gap-2">
                <p class="text-sm font-medium text-white/75">
                  ¿Qué duda principal quieres resolver en la asesoría?
                </p>
                <Textarea
                  id="question"
                  name="question"
                  rows={4}
                  placeholder="Cuéntanos tu duda principal..."
                  class="border-white/15 bg-white/7 text-white placeholder:text-white/35"
                />
              </div>

              <Alert
                id="form-error-1"
                variant="error"
                class="hidden py-3 text-red-100"
                ><AlertDescription class="text-xs"
                  >Revisa los campos indicados antes de continuar.</AlertDescription
                ></Alert
              >
            </CardContent>
            <CardFooter class="flex-col gap-4 border-white/10 bg-transparent">
              <Button
                type="submit"
                variant="primary"
                size="lg"
                class="w-full rounded-xl font-bold">Continuar</Button
              >
            </CardFooter>
          </Form>
        </div>
        <div id="form-step-2" class="hidden flex-col gap-3">
          <CardHeader>
            <div class="flex items-center justify-between">
              <Badge
                tone="primary-accent"
                appearance="outline"
                eyebrow
                size="sm">Asesoría gratuita</Badge
              >
              <Badge
                tone="neutral"
                appearance="text"
                size="sm"
                class="text-white/50">Paso 2 de 3</Badge
              >
            </div>
            <CardTitle
              ><h2
                id="contact-title"
                tabindex="-1"
                class="font-display text-2xl font-semibold text-white outline-none"
              >
                Datos de contacto
              </h2></CardTitle
            >
            <CardDescription class="text-white/65"
              >Completa tus datos para reservar tu asesoría.</CardDescription
            >
          </CardHeader>
          <Form id="lead-form-2" novalidate class="flex flex-col gap-5">
            <CardContent class="flex flex-col gap-4">
              <Field name="name" class="gap-1.5">
                <FieldLabel for="name" class="text-white/75"
                  >Nombre completo</FieldLabel
                >
                <FieldControl
                  size="sm"
                  id="name"
                  name="name"
                  type="text"
                  autocomplete="name"
                  required
                  minlength="2"
                  placeholder="Tu nombre y apellido"
                  class="border-white/15 bg-white/7 text-white placeholder:text-white/35"
                />
                <FieldError match="valueMissing"
                  >Escribe tu nombre completo.</FieldError
                >
                <FieldError match="tooShort"
                  >Escribe al menos dos caracteres.</FieldError
                >
              </Field>
              <Field name="email" class="gap-1.5">
                <FieldLabel for="email" class="text-white/75"
                  >Correo electrónico</FieldLabel
                >
                <FieldControl
                  size="sm"
                  id="email"
                  name="email"
                  type="email"
                  autocomplete="email"
                  required
                  placeholder="nombre@empresa.com"
                  class="border-white/15 bg-white/7 text-white placeholder:text-white/35"
                />
                <FieldError match="valueMissing">Escribe tu correo.</FieldError>
                <FieldError match="typeMismatch"
                  >Escribe un correo válido.</FieldError
                >
              </Field>
              <div class="grid grid-cols-[7.5rem_1fr] gap-2">
                <Field class="gap-1.5">
                  <FieldLabel for="country" class="text-white/75"
                    >País</FieldLabel
                  >
                  <NativeSelect
                    id="country"
                    size="sm"
                    name="country"
                    class="border-white/15 bg-white/7 text-white"
                  >
                    <NativeSelectOption value="+593">EC +593</NativeSelectOption
                    ><NativeSelectOption value="+57">CO +57</NativeSelectOption
                    ><NativeSelectOption value="+52">MX +52</NativeSelectOption
                    ><NativeSelectOption value="+51">PE +51</NativeSelectOption
                    ><NativeSelectOption value="+1">US +1</NativeSelectOption
                    ><NativeSelectOption value="+34">ES +34</NativeSelectOption>
                  </NativeSelect>
                </Field>
                <Field name="phone" class="gap-1.5">
                  <FieldLabel for="phone" class="text-white/75"
                    >Teléfono / WhatsApp</FieldLabel
                  >
                  <FieldControl
                    size="sm"
                    id="phone"
                    name="phone"
                    type="tel"
                    inputmode="tel"
                    autocomplete="tel"
                    required
                    pattern="[0-9+\-().\s]+"
                    minlength="7"
                    maxlength="15"
                    placeholder="099 123 4567"
                    class="border-white/15 bg-white/7 text-white placeholder:text-white/35"
                  />
                  <FieldError match="valueMissing"
                    >Escribe tu número.</FieldError
                  >
                  <FieldError match="tooShort"
                    >Escribe un número de teléfono válido.</FieldError
                  >
                  <FieldError match="patternMismatch"
                    >Solo se permiten números, espacios o guiones.</FieldError
                  >
                </Field>
              </div>

              <div class="absolute -left-[9999px]" aria-hidden="true">
                <label for="website">Sitio web</label>
                <input
                  id="website"
                  name="website"
                  type="text"
                  tabindex="-1"
                  autocomplete="off"
                />
              </div>

              <Alert
                id="form-error-2"
                variant="error"
                class="hidden py-3 text-red-100"
                ><AlertDescription id="form-error-2-description" class="text-xs"
                   >Revisa los campos indicados antes de continuar.</AlertDescription
                 ></Alert
              >
            </CardContent>
            <CardFooter class="flex-col gap-4 border-white/10 bg-transparent">
              <div class="grid w-full grid-cols-2 gap-2">
                <Button
                  id="back-btn"
                  type="button"
                  variant="outline"
                  size="lg"
                  class="rounded-xl bg-background font-bold text-foreground"
                  >Volver</Button
                >
                <Button
                  id="lead-submit"
                  type="submit"
                  variant="primary"
                  size="lg"
                  class="rounded-xl font-bold">Elegir horario</Button
                >
              </div>
              <p class="text-center text-[.7rem] leading-5 text-white/45">
                Tus datos se utilizan únicamente para gestionar esta asesoría.
              </p>
            </CardFooter>
          </Form>
        </div>
        <div id="calendar-step" class="hidden gap-5">
          <CardHeader
            ><Badge
              tone="primary-accent"
              appearance="outline"
              eyebrow
              size="sm"
              class="w-fit">Paso 3 de 3</Badge
            ><CardTitle
              ><h2
                id="calendar-title"
                tabindex="-1"
                class="font-display text-2xl font-semibold text-white outline-none"
              >
                Elige tu horario
              </h2></CardTitle
            ><CardDescription
              id="calendar-greeting"
              aria-live="polite"
              class="text-white/65"
            /></CardHeader
          >
          <CardContent
            ><div
              class="w-[calc(100%+5rem)] -mx-10 overflow-hidden bg-background mt-5 rounded-b-xl"
            >
              <iframe
                id="calendar-frame"
                title="Calendario de reservas"
                class="h-[540px] w-full border-0"></iframe>
            </div></CardContent
          >
        </div>
      </Card>
    </div>
  </section>

  <section class="border-y border-slate-200 bg-white py-7">
    <div
      class="mx-auto flex max-w-7xl flex-wrap items-center justify-center gap-x-12 gap-y-5 px-5 text-center lg:px-8"
    >
      <Badge tone="neutral" appearance="text" eyebrow size="sm"
        >Acompañamiento para</Badge
      >{
        ["Mercury", "Relay", "Stripe", "IRS"].map((name) => (
          <Badge
            tone="neutral"
            appearance="outline"
            size="lg"
            class="font-display font-bold"
          >
            {name}
          </Badge>
        ))
      }
    </div>
  </section>

  <section class="py-20 sm:py-24">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="max-w-2xl">
        <p class="section-kicker">Para quién es</p><h2 class="section-title">
          Una estructura internacional para negocios que ya piensan global.
        </h2>
      </div><div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          audiences.map(([title, text], i) => (
            <Card class="group rounded-2xl transition hover:-translate-y-1 hover:border-primary/60 hover:shadow-xl">
              <CardHeader>
                <Badge
                  tone="primary-accent"
                  appearance="soft"
                  size="lg"
                  class="size-10 justify-center p-0"
                >
                  0{i + 1}
                </Badge>
                <CardTitle>
                  <h3 class="font-display text-lg font-semibold">{title}</h3>
                </CardTitle>
                <CardContent>
                  <CardDescription class="leading-6">{text}</CardDescription>
                </CardContent>
              </CardHeader>
            </Card>
          ))
        }
      </div>
    </div>
  </section>

  <section class="relative bg-foreground py-20 text-background sm:py-24">
    <div
      class="absolute inset-0 opacity-10 [background-image:linear-gradient(45deg,transparent_48%,#e1b760_49%,#e1b760_51%,transparent_52%)] [background-size:48px_48px]"
    >
    </div><div
      class="relative mx-auto grid max-w-7xl gap-12 px-5 lg:grid-cols-[.85fr_1.15fr] lg:px-8"
    >
      <div>
        <p class="section-kicker text-primary">Primero, estrategia</p><h2
          class="font-display text-3xl font-bold tracking-[-.03em] sm:text-4xl"
        >
          Abrir es fácil. Abrir bien es otra historia.
        </h2><p class="mt-5 leading-7 text-white/65">
          Una mala decisión puede sumar costos, obligaciones innecesarias o
          retrasos bancarios. Por eso no empezamos vendiéndote un paquete.
        </p><Button
          href="#agendar"
          variant="primary"
          size="lg"
          class="mt-8 rounded-xl font-bold">Revisar mi caso gratis</Button
        >
      </div><div class="grid gap-4 sm:grid-cols-3">
        {
          [
            [
              "USD 25.000",
              "puede ser la multa por incumplimientos específicos.",
            ],
            ["50 estados", "no significa que todos sean adecuados para ti."],
            ["1 oportunidad", "para preparar bien una solicitud bancaria."],
          ].map(([n, t]) => (
            <Card class="rounded-2xl border-white/10 bg-white/5 text-white shadow-none backdrop-blur flex justify-center">
              <CardHeader>
                <>
                  <CardTitle class="font-display text-2xl text-primary">
                    {n}
                  </CardTitle>
                </>
              </CardHeader>
              <CardContent>
                <CardDescription class="leading-6 text-white/65">
                  {t}
                </CardDescription>
              </CardContent>
            </Card>
          ))
        }
      </div>
    </div>
  </section>

  <section id="proceso" class="scroll-mt-24 bg-muted py-20 sm:py-24">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <p class="section-kicker justify-center">Cómo funciona</p><h2
          class="section-title"
        >
          De la duda a un plan concreto en tres pasos.
        </h2>
      </div><div class="relative mt-14 grid gap-5 lg:grid-cols-3">
        <div
          class="absolute left-[16%] right-[16%] top-8 hidden h-px bg-primary/40 lg:block"
        >
        </div>{
          steps.map(([n, t, d]) => (
            <Card class="relative rounded-2xl">
              <CardHeader>
                <Badge
                  tone="primary-accent"
                  appearance="outline"
                  size="lg"
                  class="relative z-10 size-16 justify-center rounded-2xl p-0 font-display text-lg"
                >
                  {n}
                </Badge>
                <CardTitle>
                  <h3 class="font-display text-xl font-semibold">{t}</h3>
                </CardTitle>
                <CardDescription class="leading-6">{d}</CardDescription>
              </CardHeader>
            </Card>
          ))
        }
      </div>
    </div>
  </section>

  <section id="planes" class="scroll-mt-24 py-20 sm:py-24">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="flex flex-col justify-between gap-5 md:flex-row md:items-end">
        <div class="max-w-2xl">
          <p class="section-kicker">Planes orientativos</p><h2
            class="section-title"
          >
            Acompañamiento para cada etapa.
          </h2>
        </div><p class="max-w-sm text-sm leading-6 text-slate-500">
          Valores anuales sin tasa estatal. El plan correcto se define en la
          asesoría.
        </p>
      </div><div class="mt-12 grid gap-5 lg:grid-cols-3">
        {
          plans.map(([name, price, desc], i) => (
            <Card
              class:list={[
                "relative rounded-3xl",
                i === 2
                  ? "border-primary bg-foreground text-background shadow-2xl"
                  : "",
              ]}
            >
              {i === 2 && (
                <Badge
                  tone="primary"
                  appearance="solid"
                  eyebrow
                  size="sm"
                  class="absolute right-6 top-6"
                >
                  MÁS ELEGIDO
                </Badge>
              )}
              <CardHeader>
                <CardTitle>
                  <h3
                    class:list={[
                      "font-display text-lg font-semibold",
                      i === 2 && "text-white",
                    ]}
                  >
                    {name}
                  </h3>
                </CardTitle>
                <p class="mt-7">
                  <span class="font-display text-4xl font-bold">${price}</span>
                  <span class="ml-2 text-sm opacity-50">USD / año</span>
                </p>
