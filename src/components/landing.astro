<div
  class="fixed inset-x-0 bottom-0 z-40 border-t border-slate-200 bg-white/95 p-3 shadow-[0_-8px_30px_rgba(15,23,42,.1)] backdrop-blur md:hidden"
>
  <Button
    href="#agendar"
    variant="primary"
    size="lg"
    class="w-full rounded-xl font-bold">Agendar gratis</Button
  >
</div>

<script>
  const form1 = document.querySelector<HTMLFormElement>("#lead-form-1");
  const form2 = document.querySelector<HTMLFormElement>("#lead-form-2");
  const formStep1 = document.querySelector<HTMLElement>("#form-step-1");
  const formStep2 = document.querySelector<HTMLElement>("#form-step-2");
  const calendarStep = document.querySelector<HTMLElement>("#calendar-step");
  const contactTitle = document.querySelector<HTMLElement>("#contact-title");
  const backBtn = document.querySelector<HTMLButtonElement>("#back-btn");
  const frame = document.querySelector<HTMLIFrameElement>("#calendar-frame");
  const greeting = document.querySelector<HTMLElement>("#calendar-greeting");
  const calendarTitle = document.querySelector<HTMLElement>("#calendar-title");
  const error1 = document.querySelector<HTMLElement>("#form-error-1");
  const error2 = document.querySelector<HTMLElement>("#form-error-2");
  const error2Description = document.querySelector<HTMLElement>(
    "#form-error-2-description"
  );
  const phoneInput = document.querySelector<HTMLInputElement>("#phone");
  const submitButton = document.querySelector<HTMLButtonElement>("#lead-submit");
  const submissionId = crypto.randomUUID();
  let isSubmitting = false;

  function setForm2Error(message: string) {
    if (error2Description) error2Description.textContent = message;
    error2?.classList.remove("hidden");
  }

  function setSubmitting(submitting: boolean) {
    isSubmitting = submitting;
    if (!submitButton) return;
    submitButton.disabled = submitting;
    submitButton.textContent = submitting ? "Guardando..." : "Elegir horario";
    if (submitting) submitButton.setAttribute("aria-busy", "true");
    else submitButton.removeAttribute("aria-busy");
  }

  function showStep(step: HTMLElement | null | undefined) {
    [formStep1, formStep2, calendarStep].forEach((s) => s?.classList.add("hidden"));
    step?.classList.remove("hidden");
  }

  form1?.addEventListener("submit", (event) => {
    event.preventDefault();
    if (!form1.checkValidity()) {
      form1.reportValidity();
      error1?.classList.remove("hidden");
      return;
    }
    error1?.classList.add("hidden");
    showStep(formStep2);
    document
      .querySelector("#agendar")
      ?.scrollIntoView({ behavior: "smooth", block: "start" });
    contactTitle?.focus({ preventScroll: true });
  });

  backBtn?.addEventListener("click", () => {
    showStep(formStep1);
    document
      .querySelector("#agendar")
      ?.scrollIntoView({ behavior: "smooth", block: "start" });
  });

  phoneInput?.addEventListener("input", () => {
    phoneInput.setCustomValidity("");
  });

  form2?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (isSubmitting) return;
    phoneInput?.setCustomValidity("");
    const phoneDigits = String(phoneInput?.value || "").replace(/\D/g, "");
    if (phoneInput?.value && phoneDigits.length < 7) {
      phoneInput.setCustomValidity(
        "Escribe un número de teléfono válido (al menos 7 dígitos)."
      );
    }
    if (!form2.checkValidity()) {
      form2.reportValidity();
      setForm2Error("Revisa los campos indicados antes de continuar.");
      return;
    }
    error2?.classList.add("hidden");
    const data2 = new FormData(form2);
    const data1 = form1 ? new FormData(form1) : new FormData();
    const name = String(data2.get("name") || "");
    const phone = `${data2.get("country") || ""}${String(data2.get("phone") || "")
      .replace(/\D/g, "")
      .replace(/^0+/, "")}`;

    setSubmitting(true);
    try {
      const response = await fetch("/api/leads", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          submissionId,
          name,
          email: String(data2.get("email") || ""),
          countryCode: String(data2.get("country") || ""),
          phone: String(data2.get("phone") || ""),
          activity: String(data1.get("activity") || ""),
          advice: String(data1.get("advice") || ""),
          question: String(data1.get("question") || ""),
          source: "landing",
          website: String(data2.get("website") || ""),
        }),
      });

      if (!response.ok) {
        setForm2Error("No pudimos guardar tus datos. Inténtalo nuevamente.");
        return;
      }
    } catch {
      setForm2Error(
        "No pudimos conectar con el servidor. Revisa tu conexión e inténtalo nuevamente."
      );
      return;
    } finally {
      setSubmitting(false);
    }

    const url = new URL("https://zcal.co/t/agendar-asesoria-llc/60min");
    url.searchParams.set("name", name);
    url.searchParams.set("email", String(data2.get("email") || ""));
    url.searchParams.set("smsPhone", phone);
    url.searchParams.set("a0", phone);
    url.searchParams.set("a1", String(data1.get("activity") || ""));
    url.searchParams.set("a2", String(data1.get("advice") || ""));
    url.searchParams.set("a3", String(data1.get("question") || ""));
    if (frame) frame.src = url.toString();
    if (greeting)
      greeting.textContent = `${name.split(" ")[0]}, tus datos están listos. Selecciona el día y la hora.`;
    showStep(calendarStep);
    document
      .querySelector("#agendar")
      ?.scrollIntoView({ behavior: "smooth", block: "start" });
    calendarTitle?.focus({ preventScroll: true });
  });
</script>
