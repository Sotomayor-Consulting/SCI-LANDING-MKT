---
import { Button } from "@/components/starwind/button";
import {
  Card,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@/components/starwind/card";

export interface FeatureItem {
  title: string;
  description: string;
  /** Trazo(s) SVG 24×24 para el icono. */
  iconPath: string;
}

interface Props {
  kicker: string;
  title: string;
  description: string;
  items: FeatureItem[];
  footLead?: string;
  ctaHref: string;
  ctaLabel: string;
  ctaNote?: string;
}
const {
  kicker,
  title,
  description,
  items,
  footLead,
  ctaHref,
  ctaLabel,
  ctaNote,
} = Astro.props;
---

<section class="bg-muted/40 py-20 sm:py-24">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <div class="max-w-2xl">
      <p class="section-kicker">{kicker}</p>
      <h2 class="section-title">{title}</h2>
      <p class="mt-4 leading-7 text-slate-600">{description}</p>
    </div>
    <div class="mt-10 grid gap-5 md:grid-cols-3">
      {
        items.map((item) => (
          <Card class="rounded-2xl">
            <CardHeader>
              <span class="mb-3 grid size-9 place-items-center rounded-lg border border-[#e8c77c] bg-[#faf3e4] text-[#a66e1c]">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="size-5">
                  <path d={item.iconPath} />
                </svg>
              </span>
              <CardTitle class="text-lg">{item.title}</CardTitle>
              <CardDescription>{item.description}</CardDescription>
            </CardHeader>
          </Card>
        ))
      }
    </div>
    {footLead && <p class="mt-8 font-display font-semibold text-[#0d2638]">{footLead}</p>}
    <div class="mt-4 flex flex-wrap items-center gap-4">
      <Button
        href={ctaHref}
        variant="primary"
        size="lg"
        data-scroll-calendar
        data-cta="why-first"
        class="rounded-xl font-bold">{ctaLabel}</Button
      >
      {ctaNote && <span class="text-xs text-slate-500">{ctaNote}</span>}
    </div>
  </div>
</section>
