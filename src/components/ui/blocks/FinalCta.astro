---
import { Button } from "@/components/starwind/button";
import { Card } from "@/components/starwind/card";

interface Props {
  title: string;
  description: string;
  primaryHref: string;
  primaryLabel: string;
  secondaryHref: string;
  secondaryLabel: string;
  note?: string;
}
const {
  title,
  description,
  primaryHref,
  primaryLabel,
  secondaryHref,
  secondaryLabel,
  note,
} = Astro.props;
---

<section class="px-5 pb-20 lg:px-8">
  <Card
    class="bg-foreground text-background relative mx-auto max-w-7xl overflow-hidden rounded-[2rem] border-0 px-6 py-14 text-center sm:py-16"
  >
    <div class="border-primary/20 absolute -top-24 -left-24 size-64 rounded-full border"></div>
    <div class="relative mx-auto max-w-2xl">
      <h2 class="font-display text-3xl font-bold sm:text-4xl">{title}</h2>
      <p class="mt-4 leading-7 text-white/70">{description}</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <Button
          href={primaryHref}
          variant="primary"
          size="lg"
          data-scroll-calendar
          data-cta="final"
          class="rounded-xl px-8 font-bold">{primaryLabel}</Button
        >
        <Button
          href={secondaryHref}
          target="_blank"
          rel="noopener"
          variant="outline"
          size="lg"
          data-cta="final-wa"
          class="rounded-xl border-white/30 bg-transparent px-8 font-bold text-white hover:bg-white/10"
          >{secondaryLabel}</Button
        >
      </div>
      {note && <p class="mt-3 text-xs text-white/55">{note}</p>}
    </div>
  </Card>
</section>
