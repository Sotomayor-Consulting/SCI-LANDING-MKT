---
import { Badge } from "@/components/starwind/badge";

interface Props {
  kicker: string;
  title: string;
  description: string;
  chips: string[];
  note?: string;
}
const { kicker, title, description, chips, note } = Astro.props;
---

<section class="bg-foreground text-background py-20 sm:py-24">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <div class="max-w-2xl">
      <p class="section-kicker text-[#e4c078]">{kicker}</p>
      <h2 class="font-display text-3xl font-bold tracking-[-.035em] sm:text-4xl">{title}</h2>
      <p class="mt-4 leading-7 text-white/70">{description}</p>
    </div>
    <div class="mt-6 flex flex-wrap gap-2.5">
      {
        chips.map((chip) => (
          <Badge
            tone="neutral"
            appearance="outline"
            size="md"
            class="border-white/15 font-display font-semibold text-white/85"
          >
            {chip}
          </Badge>
        ))
      }
    </div>
    {note && <p class="mt-4 text-sm text-white/55">{note}</p>}
  </div>
</section>
