---
// Google Tag Manager para el <head> (sin partytown). Montar con slot="head".
interface Props {
  gtmId: string;
  pageName?: string;
  pageCategory?: string;
}
const { gtmId, pageName = "", pageCategory = "" } = Astro.props;
---

<link rel="preconnect" href="https://www.googletagmanager.com" />
<script is:inline define:vars={{ gtmId, pageName, pageCategory }}>
  (function (w, d, s, l, i) {
    w[l] = w[l] || [];
    w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js", page_name: pageName, page_category: pageCategory });
    var f = d.getElementsByTagName(s)[0],
      j = d.createElement(s),
      dl = l != "dataLayer" ? "&l=" + l : "";
    j.async = true;
    j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
    f.parentNode.insertBefore(j, f);
  })(window, document, "script", "dataLayer", gtmId);
</script>
