---
import { Icon } from "astro-icon/components";
import { Badge } from "@/components/starwind/badge";

interface Props {
  badge: string;
  logos: { name: string; class: string }[];
  title: string;
  points: string[];
  note: string;
}
const { badge, logos, title, points, note } = Astro.props;
---

<section class="bg-muted border-y border-slate-200 py-10">
  <div
    class="mx-auto grid max-w-7xl items-center gap-8 px-5 lg:grid-cols-[.9fr_1.4fr] lg:gap-12 lg:px-8"
  >
    <div class="flex flex-col items-start gap-4 border-slate-300 lg:border-r lg:pr-10">
      <Badge tone="primary-accent" eyebrow size="sm">{badge}</Badge>
      <div class="flex items-center gap-6 text-[#12314c]">
        {logos.map((logo) => <Icon name={logo.name} class={logo.class} />)}
      </div>
    </div>
    <div>
      <h3 class="section-title text-2xl">{title}</h3>
      <ul class="mt-4 grid gap-2.5">
        {
          points.map((point) => (
            <li class="grid grid-cols-[auto_1fr] gap-2.5 text-sm leading-6 text-slate-600">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" class="mt-0.5 size-4 text-[#a66e1c]">
                <path d="M20 6 9 17l-5-5" />
              </svg>
              <span>{point}</span>
            </li>
          ))
        }
      </ul>
      <p class="mt-3 max-w-2xl text-xs text-slate-500">{note}</p>
    </div>
  </div>
</section>
