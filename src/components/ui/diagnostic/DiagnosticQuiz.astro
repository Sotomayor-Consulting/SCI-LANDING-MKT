---
import { Alert, AlertDescription } from "@/components/starwind/alert";
import { Badge } from "@/components/starwind/badge";
import { Button } from "@/components/starwind/button";
import {
  Card,
  CardContent,
  CardDescription,
  CardFooter,
  CardHeader,
  CardTitle,
} from "@/components/starwind/card";
import {
  Field,
  FieldControl,
  FieldDescription,
  FieldError,
  FieldLabel,
} from "@/components/starwind/field";
import { Form } from "@/components/starwind/form";
import {
  NativeSelect,
  NativeSelectOption,
} from "@/components/starwind/native-select";
import { Progress } from "@/components/starwind/progress";
import { Separator } from "@/components/starwind/separator";
import DiagnosticQuestion from "./DiagnosticQuestion.astro";
import type { DiagnosticQuestion as Question } from "./types";

interface Props {
  questions: Question[];
}

const { questions } = Astro.props as Props;

const countries = [
  ["+593", "EC +593"], ["+52", "MX +52"], ["+57", "CO +57"],
  ["+51", "PE +51"], ["+56", "CL +56"], ["+54", "AR +54"],
  ["+502", "GT +502"], ["+506", "CR +506"], ["+507", "PA +507"],
  ["+503", "SV +503"], ["+504", "HN +504"], ["+505", "NI +505"],
  ["+591", "BO +591"], ["+58", "VE +58"], ["+598", "UY +598"],
  ["+595", "PY +595"], ["+1", "US / DO +1"], ["+34", "ES +34"],
];
---

<main id="diagnostic-quiz" class="hidden min-h-dvh bg-[#0e2637] px-3 py-24 sm:px-5" aria-hidden="true">
  <Card id="diagnostic-card" class="mx-auto max-w-2xl overflow-hidden rounded-2xl border-0 shadow-2xl">
    <div class="border-b px-6 py-5">
      <Progress id="diagnostic-progress" label="Progreso del diagnóstico" value={0} variant="primary" />
      <p id="diagnostic-progress-label" class="mt-2 text-right text-xs font-semibold text-muted-foreground">
        Pregunta 1 de 6
      </p>
    </div>

    {questions.map((question, index) => (
      <DiagnosticQuestion
        question={question}
        step={index === 0 ? 1 : index + 2}
        questionNumber={index + 1}
        showBack={index > 0}
      />
    ))}

    <section class="diagnostic-step hidden" data-step="2">
      <CardHeader class="text-center">
        <Badge class="mx-auto w-fit" tone="primary-accent" appearance="soft">Personalizamos tu resultado</Badge>
        <CardTitle><h2 tabindex="-1" class="font-display text-2xl font-bold outline-none sm:text-3xl">Antes de seguir, ¿cómo te llamas?</h2></CardTitle>
        <CardDescription>Para hacerte el diagnóstico con tu nombre, no genérico.</CardDescription>
      </CardHeader>
      <CardContent>
        <Field name="first_name">
          <FieldLabel for="diagnostic-first-name">Nombre</FieldLabel>
          <FieldControl id="diagnostic-first-name" name="first_name" autocomplete="given-name" required minlength="2" maxlength="40" placeholder="Tu nombre" />
          <FieldError match="valueMissing">Escribe tu nombre.</FieldError>
          <FieldError match="tooShort">Escribe al menos dos caracteres.</FieldError>
        </Field>
      </CardContent>
      <CardFooter class="grid grid-cols-[auto_1fr] gap-3">
        <Button type="button" variant="outline" size="lg" class="diagnostic-back rounded-xl" aria-label="Atrás">←</Button>
        <Button id="diagnostic-name-next" type="button" size="lg" class="rounded-xl font-bold" disabled>Continuar</Button>
      </CardFooter>
    </section>

    <section class="diagnostic-step hidden" data-step="8">
      <CardHeader class="text-center">
        <Badge id="diagnostic-stage-badge" class="mx-auto w-fit" tone="primary-accent" appearance="soft" />
        <CardTitle><h2 id="diagnostic-gate-title" tabindex="-1" class="font-display text-2xl font-bold outline-none sm:text-3xl">Tu diagnóstico está hecho.</h2></CardTitle>
        <CardDescription id="diagnostic-gate-description">Dinos a dónde enviamos tu hoja de ruta.</CardDescription>
      </CardHeader>
      <CardContent>
        <p class="mb-6 text-center text-xs leading-5 text-muted-foreground"><strong class="text-primary-accent">★ 4,3/5</strong> Trustpilot · +5.000 empresas · 10 años</p>
        <Form id="diagnostic-lead-form" novalidate class="grid gap-5">
          <Field name="last_name">
            <FieldLabel for="diagnostic-last-name">Apellido</FieldLabel>
            <FieldControl id="diagnostic-last-name" name="last_name" autocomplete="family-name" required minlength="2" maxlength="60" placeholder="Tu apellido" />
            <FieldError match="valueMissing">Escribe tu apellido.</FieldError>
            <FieldError match="tooShort">Escribe un apellido válido.</FieldError>
          </Field>
          <Field name="phone">
            <FieldLabel for="diagnostic-phone">WhatsApp</FieldLabel>
            <FieldDescription>Dudas resueltas al instante y tips concretos para tu caso.</FieldDescription>
            <div class="grid grid-cols-[8rem_1fr] gap-2">
              <NativeSelect id="diagnostic-country" name="country_code" aria-label="Código de país" required>
                {countries.map(([value, label]) => <NativeSelectOption value={value}>{label}</NativeSelectOption>)}
              </NativeSelect>
              <FieldControl id="diagnostic-phone" name="phone" type="tel" inputmode="numeric" autocomplete="tel-national" required minlength="7" maxlength="15" pattern="[0-9 ]+" placeholder="099 123 4567" />
            </div>
            <FieldError match="valueMissing">Escribe tu WhatsApp.</FieldError>
            <FieldError match="tooShort">Escribe un número válido.</FieldError>
            <FieldError match="patternMismatch">Usa solo números y espacios.</FieldError>
          </Field>
          <Field name="email">
            <FieldLabel for="diagnostic-email">Correo electrónico</FieldLabel>
            <FieldControl id="diagnostic-email" name="email" type="email" autocomplete="email" required placeholder="tucorreo@ejemplo.com" />
            <FieldError match="valueMissing">Escribe tu correo.</FieldError>
            <FieldError match="typeMismatch">Escribe un correo válido.</FieldError>
          </Field>
          <input name="website" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <Alert id="diagnostic-form-error" variant="error" class="hidden">
            <AlertDescription>Revisa los campos indicados antes de continuar.</AlertDescription>
          </Alert>
          <div class="grid grid-cols-[auto_1fr] gap-3">
            <Button type="button" variant="outline" size="lg" class="diagnostic-back rounded-xl" aria-label="Atrás">←</Button>
            <Button id="diagnostic-submit" type="submit" size="lg" class="rounded-xl font-bold">Ver mi diagnóstico →</Button>
          </div>
          <p class="text-center text-xs text-muted-foreground">Al enviar aceptas nuestra <a class="text-primary-accent underline" href="https://www.sotomayorconsulting.com/politicas" target="_blank" rel="noopener">política de privacidad</a>.</p>
        </Form>
      </CardContent>
    </section>

    <section class="diagnostic-step hidden" data-step="9">
      <div id="diagnostic-result">
        <CardHeader>
          <p id="result-eyebrow" class="text-primary-accent text-sm font-semibold"></p>
          <CardTitle><h2 id="result-verdict" tabindex="-1" class="font-display text-2xl leading-tight font-extrabold outline-none sm:text-3xl"></h2></CardTitle>
          <div class="grid grid-cols-4 gap-2 pt-2" aria-label="Etapa del negocio">
            {[1, 2, 3, 4].map((stage) => <span class="result-stage h-2 rounded-full bg-muted" data-result-stage={stage}></span>)}
          </div>
          <CardDescription id="result-headline" class="text-sm leading-6 sm:text-base"></CardDescription>
        </CardHeader>
        <CardContent class="grid gap-5">
          <Button id="result-primary" type="button" size="lg" class="w-full rounded-xl font-bold"></Button>
          <p id="result-note" class="text-center text-xs text-muted-foreground"></p>
          <p class="text-center text-xs text-muted-foreground"><strong class="text-primary-accent">★ 4,3/5</strong> Trustpilot · +5.000 empresas · 10 años</p>
          <Separator />
          <div>
            <p class="mb-2 text-xs font-bold tracking-[.12em] text-muted-foreground uppercase">Tu situación</p>
            <dl id="result-situation" class="divide-y text-sm"></dl>
          </div>
          <Alert class="border-primary/30 bg-primary/5">
            <AlertDescription id="result-cost" class="leading-6"></AlertDescription>
          </Alert>
          <div>
            <p class="mb-2 text-xs font-bold tracking-[.12em] text-muted-foreground uppercase">Tu siguiente paso</p>
            <p id="result-route-line" class="text-sm leading-6 font-semibold"></p>
            <ul id="result-outcomes" class="mt-4 grid gap-3 text-sm text-muted-foreground"></ul>
          </div>
          <Button id="result-alternate" type="button" variant="ghost" class="text-muted-foreground"></Button>
        </CardContent>
      </div>

      <div id="diagnostic-calendar" class="hidden">
        <CardHeader class="text-center">
          <CardTitle><h2 tabindex="-1" class="font-display text-2xl font-bold outline-none">Elige tu horario</h2></CardTitle>
          <CardDescription id="calendar-greeting">Tus datos ya están cargados. Solo elige el día y la hora.</CardDescription>
        </CardHeader>
        <CardContent>
          <iframe id="diagnostic-calendar-frame" title="Calendario de reserva — Sotomayor Consulting" class="h-[620px] w-full rounded-xl border-0 bg-white"></iframe>
          <p class="mt-3 text-center text-xs text-muted-foreground">¿No carga? <a id="diagnostic-calendar-link" href="#" target="_blank" rel="noopener" class="text-primary-accent underline">Abrir en otra pestaña</a></p>
        </CardContent>
      </div>

      <div id="diagnostic-confirmation" class="hidden">
        <CardHeader class="text-center">
          <Badge class="mx-auto size-12 justify-center rounded-full text-xl">✓</Badge>
          <CardTitle><h2 id="confirmation-title" tabindex="-1" class="font-display text-2xl font-bold outline-none"></h2></CardTitle>
          <CardDescription id="confirmation-description" class="leading-6"></CardDescription>
        </CardHeader>
        <CardFooter><Button id="confirmation-action" type="button" size="lg" class="w-full rounded-xl font-bold"></Button></CardFooter>
      </div>
    </section>
  </Card>
</main>

<div id="diagnostic-sticky" class="fixed inset-x-0 bottom-0 z-50 hidden border-t bg-background/95 p-3 backdrop-blur-xl">
  <Button id="diagnostic-sticky-button" type="button" size="lg" class="mx-auto flex w-full max-w-2xl rounded-xl font-bold">Agendar mi sesión →</Button>
</div>
