---
import "@/styles/starwind.css";
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
  robots?: string;
  favicon?: string;
}

const {
  title = "Asesoría para tu LLC en Estados Unidos | Nexo International",
  description = "Asesoría estratégica gratuita para crear y operar una LLC en Estados Unidos.",
  robots = "index,follow",
  favicon,
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#0b2334" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {favicon && <link rel="icon" type="image/png" href={favicon} />}
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap" rel="stylesheet" />
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
